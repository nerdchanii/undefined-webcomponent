{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@packages/cheapers",
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "paths": {
      "@packages/cheapers/*": [
        "./packages/cheapers/src/*"
      ],
      "@packages/cheapers": [
        "./packages/cheapers/src/index.ts"
      ],
      "@examples/*": [
        "./examples/*"
      ]
    }
  },
  "include": [
    "packages/**/*",
    "examples/**/*"
  ]
}
